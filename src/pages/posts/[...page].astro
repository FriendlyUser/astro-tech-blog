---
/** Paginated list of every post: /posts/, /posts/2/, ... (rendered inside Starlight). */
import type { GetStaticPaths, Page } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostList from '@/components/blog/PostList.astro';
import Pager from '@/components/blog/Pager.astro';
import { getBlogIndex, topicUrl, type Post } from '@/utils/blogIndex';

export const getStaticPaths = (async ({ paginate }) => {
  const { posts } = await getBlogIndex();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const { topics, posts } = await getBlogIndex();
const title = page.currentPage === 1 ? 'Blog' : `Blog — page ${page.currentPage}`;
---

<StarlightPage
  frontmatter={{
    title,
    description: `All ${posts.length} posts on FriendlyUser's tech blog, newest first.`,
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>
    {posts.length} posts on software development, newest first. Browse by topic:
    {
      topics.map((t, i) => (
        <>
          <a href={topicUrl(t.id)}>{t.name}</a>
          {i < topics.length - 1 ? ', ' : '.'}
        </>
      ))
    }
  </p>
  <PostList posts={page.data} />
  <Pager page={page} />
</StarlightPage>
