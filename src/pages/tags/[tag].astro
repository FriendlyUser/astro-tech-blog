---
/** All posts with one tag (same /tags/<tag>/ URLs as before the Starlight move). */
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostList from '@/components/blog/PostList.astro';
import { getBlogIndex, type Post } from '@/utils/blogIndex';

export const getStaticPaths = (async () => {
  const { byTag } = await getBlogIndex();
  return [...byTag.entries()].map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<StarlightPage
  frontmatter={{
    title: `#${tag}`,
    description: `${posts.length} posts tagged ${tag}.`,
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged <strong>{tag}</strong>. <a href="/posts/">All posts</a></p>
  <PostList posts={posts} />
</StarlightPage>
