---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

import { Footer } from '@/partials/Footer';
import { Navbar } from '@/partials/Navbar';
import { AppConfig } from '@/utils/AppConfig';
import { ADSENSE_CLIENT, GA4_ID, gtagInit } from '@/utils/analytics.mjs';

export interface Props {
  head: {
    title: string;
    description: string;
    /** Optional robots directive, e.g. 'noindex, follow'. */
    robots?: string;
  };
}

const {
  head: { title, description, robots },
} = Astro.props as Props;

const pageFindUiPrimary = '#0ea5e9';
const pageFindUiText = '#000000';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script src="https://kit.fontawesome.com/741a79b827.js" crossorigin="anonymous"></script>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="author" content={AppConfig.author} />

    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>
    <style is:global>
      @media print {
        .no-print,
        .no-print * {
          display: none !important;
        }
      }
    </style>
    <!-- Google Analytics 4, only when GA4_ID is set in src/utils/analytics.mjs -->
    {GA4_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>}
    {GA4_ID && <script is:inline set:html={gtagInit} />}
    <ClientRouter />
  </head>
  <body class="bg-slate-900 text-gray-100">
    <Navbar />
    <div data-pagefind-body>
      <slot />
    </div>
    <Footer />
  </body>
</html>
